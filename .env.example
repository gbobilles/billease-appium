# Copy this file to .env and fill in values for your machine. Never commit .env.

# ---------- Appium ----------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
WAIT_TIMEOUT=20000
LOG_LEVEL=info
# true = keep app data between sessions (faster, but tests may start already logged in)
NO_RESET=false

# ---------- Android ----------
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=14
ANDROID_UDID=
# Path to the BillEase APK (optional if the app is already installed)
ANDROID_APP_PATH=./apps/billease.apk
# Confirm with: adb shell dumpsys window | grep -E "mCurrentFocus"
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# ---------- iOS ----------
# IOS_DEVICE_NAME=iPhone 15
# IOS_PLATFORM_VERSION=17.5
# IOS_UDID=
# # Path to the BillEase .app (simulator) or .ipa (real device); optional if installed
# IOS_APP_PATH=./apps/BillEase.app
# IOS_BUNDLE_ID=
# # Real devices only
# IOS_XCODE_ORG_ID=

# ---------- Test data (use a dedicated QA/staging account) ----------
TEST_MOBILE_NUMBER=
TEST_PASSWORD=
# A number that is NOT registered with BillEase
UNREGISTERED_MOBILE_NUMBER=09170000000
# Number your team controls, used for sign-up (sign-up sends a real SMS OTP).
# Sign-up tests that reach the OTP screen are skipped while this is empty.
SIGNUP_TEST_MOBILE_NUMBER=
# OTP for the test environment, if staging uses a fixed OTP
TEST_OTP=
